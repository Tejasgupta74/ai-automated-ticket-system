# Environment Configuration Example for Cerevyn Ticket Automation
# Copy this file to .env for local overrides

# Application Host & Port
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Database Configuration (Defaults to local SQLite if unset)
SQLITE_DB_PATH=tickets.db

# Azure App Service & Key Vault (Optional / Production)
AZURE_KEYVAULT_URL=https://kv-cerevyn-prod.vault.azure.net/
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Model Classification Tuning
MODEL_CONFIDENCE_THRESHOLD=0.45
AMBIGUITY_MARGIN_THRESHOLD=0.25
